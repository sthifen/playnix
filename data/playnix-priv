#!/bin/bash
# Playnix: acciones de root fijas que la sesión del usuario necesita a menudo.
# Se invoca con pkexec; la política de polkit las permite sin contraseña al usuario
# activo. Solo acepta las acciones de abajo, sin argumentos libres.
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

CFG=/var/lib/waydroid/waydroid.cfg
MODE_FILE=/var/lib/playnix/gpu-mode   # auto | hw | sw (lo elige el usuario al instalar)
LIBEXEC=/usr/libexec/playnix
HWC=lib64/hw/hwcomposer.waydroid.so
OVL=/var/lib/waydroid/overlay/vendor
HWC_STAMP=/var/lib/playnix/hwc-fix

driver_of() { basename "$(readlink -f "/sys/class/drm/$(basename "$1")/device/driver")"; }

# hw si Android puede compartir buffers con el compositor, sw si no. Se mira qué GPU
# tiene abierta el compositor AHORA (cambiar de GPU principal requiere cerrar sesión,
# así que la configuración del sistema puede no coincidir con lo que está corriendo).
gpu_detect() {
    local mesa=0 d pid dev best="" n max=0
    for d in /sys/class/drm/renderD*; do
        case "$(driver_of "$d")" in i915|xe|amdgpu|radeon|nouveau|virtio*) mesa=1 ;; esac
    done
    [ "$mesa" = 1 ] || { echo sw; return; }
    for pid in $(pgrep -x 'gnome-shell|kwin_wayland|Hyprland|sway|cosmic-comp|niri|wayfire|labwc|weston|river|mutter' || true); do
        # el dispositivo con más descriptores abiertos es el que usa para dibujar
        while read -r n dev; do
            [ "$n" -gt "$max" ] && max=$n best=$dev
        done < <(ls -l "/proc/$pid/fd" 2>/dev/null | grep -oE '/dev/dri/(renderD|card)[0-9]+' | sort | uniq -c)
    done
    if [ -n "$best" ]; then
        [ "$(driver_of "$best")" = nvidia ] && echo sw || echo hw
        return
    fi
    # sin compositor a la vista: reglas estáticas
    for d in /sys/class/drm/card[0-9]; do
        [ "$(driver_of "$d")" = nvidia ] && [ "$(cat "$d/device/boot_vga" 2>/dev/null)" = 1 ] && { echo sw; return; }
    done
    for f in /etc/udev/rules.d/*.rules; do
        grep -qs 'mutter-device-preferred-primary' "$f" && grep -qs '0x10de' "$f" && { echo sw; return; }
    done
    echo hw
}

gpu_apply() {
    local want=$1 have=hw
    grep -q '^ro.hardware.egl = swiftshader' "$CFG" && have=sw
    [ "$want" = "$have" ] && { echo "ok $have"; return; }
    sed -i '/^ro.hardware.gralloc = default$/d; /^ro.hardware.egl = swiftshader$/d' "$CFG"
    [ "$want" = sw ] && sed -i '/^\[properties\]/a ro.hardware.gralloc = default\nro.hardware.egl = swiftshader' "$CFG"
    waydroid upgrade --offline >/dev/null 2>&1
    echo "changed $want"
}

# El hwcomposer de Waydroid descarta las capas cuyo nombre no lleva "TID:<tarea>#", y
# a las SurfaceView solo se lo pone si su contexto es una Activity: juegos como Clash
# Royale quedan con la ventana transparente. Se pone en el overlay una copia del
# hwcomposer de la imagen actual que usa libpnxh.so para asignar esas capas a la
# ventana de su app (ver data/hwc-fix). Se rehace si cambia la imagen de vendor, y si
# la versión no es compatible se quita y Android queda como viene.
hwc_unfix() { rm -f "$OVL/$HWC" "$OVL/lib64/libpnxh.so" "$HWC_STAMP"; }

hwc_fix() {
    local img tmp sum r
    img="$(sed -n 's/^images_path = //p' "$CFG")/vendor.img"
    if [ ! -f "$img" ] || ! command -v debugfs >/dev/null; then echo skip; return; fi
    tmp=$(mktemp -d)
    debugfs -R "dump /$HWC $tmp/orig.so" "$img" >/dev/null 2>&1 || true
    if [ ! -s "$tmp/orig.so" ]; then
        hwc_unfix; r=skip
    else
        sum=$(cat "$tmp/orig.so" "$LIBEXEC/libpnxh.so" "$LIBEXEC/hwc-patch.py" | sha256sum | cut -d' ' -f1)
        if [ "$(cat "$HWC_STAMP" 2>/dev/null)" = "$sum" ] && [ -f "$OVL/$HWC" ]; then
            r=ok
        elif python3 -I "$LIBEXEC/hwc-patch.py" "$tmp/orig.so" "$tmp/patched.so"; then
            install -D -m 644 "$tmp/patched.so" "$OVL/$HWC"
            install -D -m 644 "$LIBEXEC/libpnxh.so" "$OVL/lib64/libpnxh.so"
            echo "$sum" > "$HWC_STAMP"
            r=changed
        else
            hwc_unfix; r=unsupported
        fi
    fi
    rm -rf "$tmp"
    echo "$r"
}

# Docker (y firewalls como ufw) dejan la política FORWARD en DROP y Android no sale a
# internet. Se acepta el tráfico de su interfaz al principio de FORWARD; Docker no
# borra reglas ajenas, pero al reiniciar la máquina se pierden: se repite en cada
# arranque de Android. No toca la configuración de Docker ni reinicia nada.
net_fix() {
    local r=ok dir
    command -v iptables >/dev/null || { echo skip; return; }
    [ "$(iptables -S FORWARD 2>/dev/null | head -1)" = "-P FORWARD ACCEPT" ] && { echo ok; return; }
    for dir in -i -o; do
        if ! iptables -C FORWARD "$dir" waydroid0 -j ACCEPT 2>/dev/null; then
            iptables -I FORWARD 1 "$dir" waydroid0 -j ACCEPT 2>/dev/null && r=changed
        fi
    done
    echo "$r"
}

case "${1:-}" in
    gpu-detect)
        gpu_detect
        ;;
    gpu-auto)
        # Solo con la sesión de Android apagada: `waydroid upgrade` reinicia el contenedor
        mode=$(cat "$MODE_FILE" 2>/dev/null || echo auto)
        [ "$mode" = auto ] && mode=$(gpu_detect)
        gpu_apply "$mode"
        ;;
    hwc-fix)
        # Antes de arrancar Android: el overlay se monta al iniciar el contenedor
        hwc_fix
        ;;
    net-fix)
        net_fix
        ;;
    adb-auth)
        # Controles de teclado: Android acepta la llave adb del usuario que llama.
        # Solo se copia una línea con forma de llave pública (base64 y comentario).
        home=$(getent passwd "${PKEXEC_UID:-${SUDO_UID:-}}" | cut -d: -f6)
        key=$(head -n1 "$home/.android/adbkey.pub" 2>/dev/null | head -c 4096)
        [[ "$key" =~ ^[A-Za-z0-9+/=]+( [A-Za-z0-9@._-]+)?$ ]] || { echo "llave adb inválida" >&2; exit 1; }
        waydroid shell -- sh -c "f=/data/misc/adb/adb_keys; mkdir -p /data/misc/adb
            grep -qxF '$key' \$f 2>/dev/null || echo '$key' >> \$f
            chown system:shell \$f; chmod 640 \$f"
        ;;
    android-id)
        waydroid shell -- sh -c "sqlite3 /data/data/com.google.android.gsf/databases/gservices.db \"select value from main where name = 'android_id';\"" 2>/dev/null | tr -dc '0-9'
        ;;
    setup-android)
        # Con teclado de PC no mostrar el teclado en pantalla
        waydroid shell -- settings put secure show_ime_with_hard_keyboard 0
        ;;
    restart-container)
        systemctl restart waydroid-container
        ;;
    install-split)
        # Instala una app partida (.xapk/.apks) que Playnix dejó en /data/waydroid_tmp/playnix-split:
        # todos los .apk en una sola sesión de instalación, y los OBB a su carpeta.
        waydroid shell -- sh -c '
            d=/data/waydroid_tmp/playnix-split
            total=0
            for f in "$d"/*.apk; do total=$((total + $(stat -c %s "$f"))); done
            sid=$(pm install-create -S "$total" | sed -n "s/.*\[\([0-9]*\)\].*/\1/p")
            [ -n "$sid" ] || { rm -rf "$d"; exit 1; }
            i=0
            for f in "$d"/*.apk; do
                pm install-write -S "$(stat -c %s "$f")" "$sid" "split$i" "$f" >/dev/null || { pm install-abandon "$sid"; rm -rf "$d"; exit 1; }
                i=$((i + 1))
            done
            pm install-commit "$sid" || { rm -rf "$d"; exit 1; }
            if [ -d "$d/obb" ]; then
                for p in "$d"/obb/*; do
                    dst=/data/media/0/Android/obb/$(basename "$p")
                    mkdir -p "$dst" && cp -r "$p"/. "$dst"/
                done
                chown -R media_rw:media_rw /data/media/0/Android/obb 2>/dev/null
            fi
            rm -rf "$d"'
        ;;
    *)
        echo "uso: playnix-priv gpu-detect|gpu-auto|hwc-fix|net-fix|adb-auth|android-id|setup-android|restart-container|install-split" >&2
        exit 2
        ;;
esac
