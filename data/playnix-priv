#!/bin/bash
# Playnix: acciones de root fijas que la sesión del usuario necesita a menudo.
# Se invoca con pkexec; la política de polkit las permite sin contraseña al usuario
# activo. Solo acepta las acciones de abajo, sin argumentos libres.
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

case "${1:-}" in
    android-id)
        waydroid shell -- sh -c "sqlite3 /data/data/com.google.android.gsf/databases/gservices.db \"select value from main where name = 'android_id';\"" 2>/dev/null | tr -dc '0-9'
        ;;
    setup-android)
        # Con teclado de PC no mostrar el teclado en pantalla
        waydroid shell -- settings put secure show_ime_with_hard_keyboard 0
        ;;
    restart-container)
        systemctl restart waydroid-container
        ;;
    install-split)
        # Instala una app partida (.xapk/.apks) que Playnix dejó en /data/waydroid_tmp/playnix-split:
        # todos los .apk en una sola sesión de instalación, y los OBB a su carpeta.
        waydroid shell -- sh -c '
            d=/data/waydroid_tmp/playnix-split
            total=0
            for f in "$d"/*.apk; do total=$((total + $(stat -c %s "$f"))); done
            sid=$(pm install-create -S "$total" | sed -n "s/.*\[\([0-9]*\)\].*/\1/p")
            [ -n "$sid" ] || { rm -rf "$d"; exit 1; }
            i=0
            for f in "$d"/*.apk; do
                pm install-write -S "$(stat -c %s "$f")" "$sid" "split$i" "$f" >/dev/null || { pm install-abandon "$sid"; rm -rf "$d"; exit 1; }
                i=$((i + 1))
            done
            pm install-commit "$sid" || { rm -rf "$d"; exit 1; }
            if [ -d "$d/obb" ]; then
                for p in "$d"/obb/*; do
                    dst=/data/media/0/Android/obb/$(basename "$p")
                    mkdir -p "$dst" && cp -r "$p"/. "$dst"/
                done
                chown -R media_rw:media_rw /data/media/0/Android/obb 2>/dev/null
            fi
            rm -rf "$d"'
        ;;
    *)
        echo "uso: playnix-priv android-id|setup-android|restart-container|install-split" >&2
        exit 2
        ;;
esac
